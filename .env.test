# ─────────────────────────────────────────────────────────────
# Test Environment Configuration
# Medical Handwriting OCR
# ─────────────────────────────────────────────────────────────
# DO NOT use these credentials in production.
# This file is loaded by pytest and CI/CD pipelines.
# ─────────────────────────────────────────────────────────────

# Application
TESTING=true
ENVIRONMENT=test
DEBUG=true
LOG_LEVEL=DEBUG

# Database — dedicated test database, never production
DATABASE_URL=postgresql://ocr_test_user:ocr_test_password@localhost:5432/medical_ocr_test

# MinIO / S3-compatible storage — test bucket
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=testminioadmin
MINIO_SECRET_KEY=testminioadmin123
MINIO_BUCKET=test-ocr-crops
MINIO_SECURE=false

# Redis (used by Celery in full stack)
REDIS_URL=redis://localhost:6379/0

# OCR Engine — use lighter models for faster tests
PADDLEOCR_LANG=ar,en
TROCR_MODEL_PATH=

# Paths — temp directories for test artifacts
UPLOAD_DIR=/tmp/medical_ocr_test/uploads
CROP_DIR=/tmp/medical_ocr_test/crops

# Security
SECRET_KEY=test-secret-key-do-not-use-in-production-abc123xyz
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Celery (used in integration tests with full stack)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
