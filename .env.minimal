# Medical Handwriting OCR — Minimal Configuration
# Copy to .env for basic CPU-only usage

# OCR Engine (Lite mode — CPU only)
OCR_ENGINE=paddleocr
BATCH_SIZE=1
MAX_IMAGE_SIZE=2048

# Disable heavy engines
ENABLE_EASYOCR=false
ENABLE_TROCR=false
ENABLE_SURYA=false

# Postprocessor
ENABLE_POSTPROCESSOR=true
PHI_MASKING=true
CONFIDENCE_THRESHOLD=0.85

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true