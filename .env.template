# MedOCR Mobile Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
VITE_API_URL=http://localhost:8000
# VITE_API_URL=https://your-production-server.com

# ============================================
# Authentication
# ============================================
VITE_API_KEY=your_api_key_here
# ⚠️  In production, use OAuth2/JWT instead of static token

# ============================================
# Firebase Configuration (for push notifications & analytics)
# ============================================
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
VITE_FIREBASE_PROJECT_ID=medical-ocr-mobile
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# ============================================
# App Configuration
# ============================================
VITE_APP_NAME=MedOCR
VITE_APP_VERSION=1.0.0
VITE_SYNC_INTERVAL=30000
VITE_MAX_SYNC_RETRIES=5
VITE_OFFLINE_CACHE_DAYS=30

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_BIOMETRIC=false
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_ANALYTICS=false

# ============================================
# Build Configuration (for CI/CD)
# ============================================
KEYSTORE_PATH=./medocr.keystore
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=medocr
KEY_PASSWORD=your_key_password
