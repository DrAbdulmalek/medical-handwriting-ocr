# ============================================
# Medical Handwriting OCR — CPU-Only Configuration
# ============================================
# Minimal configuration for CPU environments
# Copy to .env: cp .env.cpu-example .env

# OCR Engine Configuration
OCR_ENGINE=paddleocr
OCR_DEVICE=cpu
OCR_BATCH_SIZE=1
OCR_MAX_IMAGE_SIZE=2048

# Engine Toggles (disable heavy engines on CPU)
ENABLE_PADDLEOCR=true
ENABLE_EASYOCR=false
ENABLE_TROCR=false
ENABLE_SURYA=false

# Medical Postprocessor
ENABLE_POSTPROCESSOR=true
POSTPROCESSOR_PHI_MASK=true
POSTPROCESSOR_CONFIDENCE_THRESHOLD=0.7

# Streamlit UI
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_THEME=light

# Logging
LOG_LEVEL=INFO

# Paths
DATA_DIR=./data
OUTPUT_DIR=./output
MODEL_CACHE_DIR=~/.cache/medical-ocr

# Performance (CPU optimized)
MAX_CONCURRENT_REQUESTS=1
REQUEST_TIMEOUT=120
