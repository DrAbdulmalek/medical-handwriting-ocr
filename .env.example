# ── Database ──
DATABASE_URL=postgresql://ocr_user:ocr_password_123@localhost:5432/medical_ocr

# ── MinIO Object Storage ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ocr-crops
MINIO_SECURE=false

# ── OCR Engine ──
PADDLEOCR_LANG=ar,en

# ── Celery / Redis ──
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/0

# ── Security & Rate Limiting ──
API_KEY_ENABLED=false
API_KEY_AUTH_ENABLED=false
ADMIN_TOKEN=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000
DEFAULT_RATE_LIMIT=100/minute
UPLOAD_RATE_LIMIT=20/minute
CORRECTION_RATE_LIMIT=60/minute

# ── Security Headers ──
ENVIRONMENT=development
SECURITY_FRAME_OPTIONS=DENY
SECURITY_CSP_POLICY=default-src 'self'; script-src 'none'; style-src 'none'; img-src 'self' data:; font-src 'self'
SECURITY_HSTS_MAX_AGE=31536000

# ── Upload Validation ──
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,bmp,tiff,tif,webp,dcm,pdf
UPLOAD_BLOCKED_EXTENSIONS=exe,sh,bat,cmd,ps1,py,js

# ── Data Retention ──
RETENTION_DOCUMENT_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_ORPHAN_CROP_DAYS=30
RETENTION_DRY_RUN=false

# ── Dictionary ──
DICTIONARY_GITHUB_TOKEN=
DICTIONARY_GITHUB_REPO=medical-dictionaries
DICTIONARY_GITHUB_OWNER=drabdulmalrk

# ── UMLS (optional) ──
UMLS_API_KEY=
UMLS_API_BASE=https://uts.nlm.nih.gov

# ── Authentication & JWT ──
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Document Parsing (Marker + Surya) ──
MARKER_MODEL_NAME=marker_single
SURYA_LANG=ar,en

# ── Image Processing (Florence-2) ──
FLORENCE2_MODEL=microsoft/Florence-2-large
FLORENCE2_DEVICE=cuda

# ── Audio/Video (Whisper) ──
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cuda
FFMPEG_PATH=ffmpeg

# ── Speaker Diarization ──
HF_TOKEN=

# ── Web Crawling ──
CRAWLER_USER_AGENT=MedicalDataBot/1.0
CRAWLER_RATE_LIMIT=1.0
PUBMED_API_KEY=

# ── RAG / LLM ──
RAG_VECTOR_DB=chromadb
RAG_PERSIST_DIR=./data/vectorstore
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
LOCAL_LLM_URL=http://localhost:11434

# ── FHIR ──
FHIR_VERSION=R4

# ── Clinical Decision Support ──
DRUG_DATABASE_PATH=./data/drug_interactions.json
GUIDELINE_CHECK_INTERVAL=3600
GUIDELINE_SOURCES=WHO,CDC,AHA,ESC,NICE,MOH

# ── PWA Push Notifications ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Monitoring ──
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true

# ── Paths ──
UPLOAD_DIR=./uploads
CROP_DIR=./crops
MODELS_DIR=./models
